rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleFromClaims() {
      return request.auth.token.role;
    }

    function roleFromAccess() {
      return get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.role;
    }

    function role() {
      return (roleFromClaims() == 'admin' || roleFromClaims() == 'manager' || roleFromClaims() == 'staff')
        ? roleFromClaims()
        : (request.auth.token.admin == true)
          ? 'admin'
          : (exists(/databases/$(database)/documents/userAccess/$(request.auth.token.email)))
            ? roleFromAccess()
            : 'staff';
    }

    function isManager() {
      return isSignedIn() && (role() == 'admin' || role() == 'manager');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isPrimaryAdmin() {
      return isSignedIn() && (
        request.auth.token.primaryAdmin == true ||
        (
          exists(/databases/$(database)/documents/userAccess/$(request.auth.token.email)) &&
          roleFromAccess() == 'admin' &&
          get(/databases/$(database)/documents/userAccess/$(request.auth.token.email)).data.primaryAdmin == true
        )
      );
    }

    match /userAccess/{email} {
      allow read: if isSignedIn() && (isPrimaryAdmin() || request.auth.token.email == email);
      allow create, update, delete: if isPrimaryAdmin();
    }

    match /branches/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /employees/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /cheerItems/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    match /sales/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
